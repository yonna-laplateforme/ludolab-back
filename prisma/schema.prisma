generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int             @id @default(autoincrement())
  first_name      String          @db.VarChar(255)
  last_name       String          @db.VarChar(255)
  email           String          @unique(map: "email") @db.VarChar(255)
  username        String          @db.VarChar(255)
  password        String          @db.VarChar(255)
  role            String          @db.VarChar(50)
  parent_id       Int?
  created_at      DateTime        @default(now()) @db.Timestamp(0)
  is_premium      Boolean         @default(false)
  ai_interactions AiInteraction[]
  exercises       Exercise[]
  progression     Progression[]
  subscriptions   Subscription[]
  users           User?           @relation("usersTousers", fields: [parent_id], references: [id], onUpdate: Restrict, map: "users_ibfk_1")
  other_users     User[]          @relation("usersTousers")

  @@index([parent_id], map: "parent_id")
  @@map("users")
}

model AiInteraction {
  id            Int      @id @default(autoincrement())
  user_id       Int
  exercise_id   Int
  user_question String?  @db.Text
  ai_response   String?  @db.Text
  help_type     String?  @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamp(0)
  users         User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "ai_interactions_ibfk_1")
  exercises     Exercise @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "ai_interactions_ibfk_2")

  @@index([exercise_id], map: "exercise_id")
  @@index([user_id], map: "user_id")
  @@map("ai_interactions")
}

model Exercise {
  id              Int             @id @default(autoincrement())
  user_id         Int
  subject_id      Int
  image_path      String?         @db.VarChar(255)
  title           String?         @db.VarChar(255)
  level           String?         @db.VarChar(255)
  description     String          @db.Text
  ai_interactions AiInteraction[]
  users           User            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "exercises_ibfk_1")
  subjects        Subject         @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "exercises_ibfk_2")
  progression     Progression[]

  @@index([subject_id], map: "subject_id")
  @@index([user_id], map: "user_id")
  @@map("exercises")
}

model Progression {
  id               Int      @id @default(autoincrement())
  user_id          Int
  exercise_id      Int
  status           String   @default("en_cours") @db.VarChar(255)
  score_percentage Float?   @db.Float
  last_activity    DateTime @default(now()) @db.Timestamp(0)
  users            User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "progression_ibfk_1")
  exercises        Exercise @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "progression_ibfk_2")

  @@index([exercise_id], map: "exercise_id")
  @@index([user_id], map: "user_id")
  @@map("progression")
}

model Subject {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  icon      String     @db.VarChar(255)
  exercises Exercise[]

  @@map("subjects")
}

model Subscription {
  id         Int       @id @default(autoincrement())
  user_id    Int
  plan_name  String?   @db.VarChar(255)
  is_active  Boolean?  @default(false)
  start_date DateTime? @db.Date
  end_date   DateTime? @db.Date
  users      User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "subscriptions_ibfk_1")

  @@index([user_id], map: "user_id")
  @@map("subscriptions")
}
