generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model User {
  id         Int      @id @default(autoincrement())
  first_name String?  // le ? signifie optionnel
  last_name  String?
  email      String   @unique
  username   String   @unique 
  password   String
  role       String?  @default("user")
  parent_id  Int?
  created_at DateTime @default(now())
  is_premium Boolean  @default(false)

  @@map("users") // ◄ Très important : dit à Prisma que la table s'appelle "users" au pluriel
}

 
